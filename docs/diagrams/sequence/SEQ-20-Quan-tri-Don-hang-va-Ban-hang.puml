@startuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
title SEQ-20 - QUẢN TRỊ BÁN HÀNG & PHÂN TÍCH
actor "Quản trị viên" as A
boundary "Admin UI" as UI
control "Admin API" as API
control "Admin Service" as S
control "Prisma Client" as P
database "PostgreSQL" as DB
A -> UI : UC35 Mở quản lý bán hàng
UI -> API : GET/PATCH orders, customers, coupons
API -> S : validate admin + process operation
S -> P : query/update business data
P -> DB : SELECT/UPDATE Order/User/Coupon
S --> API : operation result
API --> UI : refreshed admin state
A -> UI : UC36 Mở Sales Analytics / AI Insights
UI -> API : GET /api/admin/analytics hoặc /api/admin/ai
API -> S : aggregate metrics
S -> P : query orders, payments, Try-On, Stylist, profiles
P -> DB : SELECT analytical data
S --> API : sales + AI metrics
API --> UI : dashboard insights
@enduml
