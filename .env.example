# Production secrets are configured in Vercel Environment Variables; do not commit real values here.
# ------------------------------------------------------------
# Local development
# ------------------------------------------------------------
# npm run dev uses this URL directly.
DATABASE_URL="postgresql://lsoul:lsoul_dev@localhost:5432/lsoul?schema=public"

# Docker Compose database settings.
# Compose automatically uses host "postgres" inside the Docker network.
POSTGRES_USER=lsoul
POSTGRES_PASSWORD=lsoul_dev
POSTGRES_DB=lsoul
POSTGRES_PORT=5432
APP_PORT=3000
ADMIN_PORT=3001
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"


# ------------------------------------------------------------
# Product image storage
# ------------------------------------------------------------
# local: lưu vào public/uploads (phù hợp dev/Docker local)
# cloudinary: upload lên Cloudinary (phù hợp Vercel/production)
UPLOAD_DRIVER=local

# Có thể dùng một CLOUDINARY_URL duy nhất:
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_URL=
# Hoặc dùng 3 biến riêng bên dưới:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lsoul/products

# ------------------------------------------------------------
# AI services (server-only)
# ------------------------------------------------------------
GEMINI_API_KEY=
# Độ phân giải ảnh thử đồ AI: 1K / 2K / 4K (mặc định 2K). Model ảnh Gemini cần bật billing.
TRYON_IMAGE_SIZE=2K
# Siêu phân giải ảnh kết quả thử đồ (2 = phóng 2x, 4 = 4x, off = tắt). Mặc định 2.
TRYON_UPSCALE=2
# Optional: nếu có key thì ưu tiên FASHN API 1.6.
FASHN_API_KEY=
# Optional: dùng cho Hugging Face Space / ZeroGPU fallback.
HF_TOKEN=

# ------------------------------------------------------------
# VietQR
# NEXT_PUBLIC_* values are embedded into the Next.js client build.
# Rebuild the Docker image after changing them.
# ------------------------------------------------------------
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_ACCOUNT=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=LSOUL

# ------------------------------------------------------------
# SePay webhook verification (server-only)
# Phải khớp "Webhook Secret" cấu hình trên dashboard SePay.
# Giá trị mặc định bên dưới chỉ dùng cho local/demo (xem scripts/test-sepay-webhook.mjs).
# ------------------------------------------------------------
SEPAY_WEBHOOK_SECRET="lsoul_dev_sepay_secret"

# ------------------------------------------------------------
# Demo/đồ án: cho phép trả link đặt lại mật khẩu trong response API
# khi chưa tích hợp dịch vụ gửi email. Đặt 0 hoặc bỏ trống khi chạy thật.
# ------------------------------------------------------------
PASSWORD_RESET_EXPOSE_LINK=1

