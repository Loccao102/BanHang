generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum PaymentMethod {
  qr
  cod
}

enum OrderStatus {
  processing
  confirmed
  shipping
  completed
  cancelled
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole       @default(customer)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  addresses    Address[]
  wishlist     WishlistItem[]
  cartItems    CartItem[]
  orders       Order[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String
  recipientName String
  phone         String
  address       String
  city          String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  size      String   @default("")
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size])
  @@index([userId])
}

model Product {
  id          String   @id
  sku         String   @unique
  name        String
  subtitle    String
  category    String
  type        String
  gender      String
  price       Int
  oldPrice    Int?
  color       String
  colorFamily String
  sizes       Json
  stock       Int
  image       String
  images      Json
  style       Json
  occasion    Json
  material    String
  fit         String
  featured    Boolean  @default(false)
  isNew       Boolean  @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
}

model Order {
  id           String      @id
  userId       String?
  createdAt    DateTime    @default(now())
  subtotal     Int
  shipping     Int
  discount     Int
  total        Int
  payment      PaymentMethod
  status       OrderStatus   @default(processing)
  customerName String
  phone        String
  address      String
  city         String
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      String
  productId    String
  productName  String
  productImage String
  productColor String
  productPrice Int
  size         String?
  quantity     Int
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model StoreSetting {
  key   String @id
  value String
}
