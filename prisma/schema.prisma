generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id
  sku         String   @unique
  name        String
  subtitle    String
  category    String
  type        String
  gender      String
  price       Int
  oldPrice    Int?
  color       String
  colorFamily String
  sizes       String
  stock       Int
  image       String
  images      String
  style       String
  occasion    String
  material    String
  fit         String
  featured    Boolean  @default(false)
  isNew       Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id           String      @id
  createdAt    DateTime    @default(now())
  subtotal     Int
  shipping     Int
  discount     Int
  total        Int
  payment      String
  status       String
  customerName String
  phone        String
  address      String
  city         String
  items        OrderItem[]
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      String
  productId    String
  productName  String
  productImage String
  productColor String
  productPrice Int
  size         String?
  quantity     Int
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StoreSetting {
  key   String @id
  value String
}
