generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum PaymentMethod {
  qr
  cod
}

enum PaymentStatus {
  pending
  paid
  cod_pending
  failed
  refunded
}

enum OrderStatus {
  processing
  confirmed
  shipping
  completed
  cancelled
}

enum DiscountType {
  percentage
  fixed
}

enum SocialPostStatus {
  pending
  approved
  rejected
}

enum BehaviorEventType {
  product_view
  search
  wishlist_add
  wishlist_remove
  cart_add
  cart_remove
  tryon_start
  tryon_success
  tryon_retry
  tryon_reject
  recommendation_shown
  recommendation_click
  recommendation_accept
  recommendation_reject
  order_created
  purchase
}

enum RecommendationFeedback {
  unknown
  accepted
  rejected
  neutral
}

enum TryOnStatus {
  created
  processing
  completed
  failed
  rejected
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole       @default(customer)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]
  addresses    Address[]
  wishlist     WishlistItem[]
  cartItems    CartItem[]
  orders       Order[]
  socialPosts  SocialPost[]
  socialEvents SocialEvent[]
  chatConversations ChatConversation[]
  styleProfile UserStyleProfile?
  behaviorEvents UserBehaviorEvent[]
  productAffinities ProductAffinity[]
  aiRecommendations AIRecommendation[]
  tryOnSessions TryOnSession[]
  outfitAssessments OutfitAssessment[]
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  title     String        @default("Cuộc trò chuyện mới")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  recommendations AIRecommendation[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  role           String
  content        String
  productIds     Json
  actions        Json             @default("[]")
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String
  recipientName String
  phone         String
  address       String
  city          String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  size      String   @default("")
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size])
  @@index([userId])
}

model Product {
  id              String              @id
  sku             String              @unique
  groupCode       String?
  name            String
  subtitle        String
  category        String
  type            String
  gender          String
  price           Int
  oldPrice        Int?
  color           String
  colorFamily     String
  colorHex        String?
  sizes           Json
  stock           Int
  stockTracked    Boolean             @default(true)
  image           String
  images          Json
  style           Json
  occasion        Json
  material        String
  fit             String
  featured        Boolean             @default(false)
  isNew           Boolean             @default(false)
  active          Boolean             @default(true)
  sourceUrl       String?
  sourceUpdatedAt DateTime?
  sourceType       String              @default("demo")
  tryOnCategory    String?
  tryOnPhotoType   String?
  tryOnImage       String?
  silhouette       String?
  lengthClass      String?
  neckline         String?
  sleeveLength     String?
  pattern          String?
  season           Json                @default("[]")
  formality        Int                 @default(2)
  warmth           Int                 @default(2)
  stretch          Int                 @default(2)
  coverage         Int                 @default(2)
  colorTemperature String?
  hoverImage        String?
  waistRise         String?
  recommendedUndertones Json           @default("[]")
  bodyShapeCompatibility Json          @default("[]")
  pairingTags       Json                @default("[]")
  avoidPairingTags  Json                @default("[]")
  visualWeight      Int                 @default(3)
  volume            String?
  styleKeywords     Json                @default("[]")
  aiSearchText      String              @default("")
  analyzerReady     Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  variants        ProductVariant[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
socialLinks     SocialPostProduct[]
  socialEvents    SocialEvent[]
  behaviorEvents  UserBehaviorEvent[]
  affinities      ProductAffinity[]

  @@index([groupCode])
  @@index([category, type])
  @@index([analyzerReady, active])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  sku        String      @unique
  size       String
  stock      Int         @default(0)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

model Coupon {
  code        String       @id
  type        DiscountType
  value       Int
  minOrder    Int          @default(0)
  maxDiscount Int?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orders      Order[]
}

model Order {
  id              String        @id
  userId          String?
  couponCode      String?
  createdAt       DateTime      @default(now())
  subtotal        Int
  shipping        Int
  discount        Int
  total           Int
  payment         PaymentMethod
  paymentStatus   PaymentStatus @default(pending)
  status          OrderStatus   @default(processing)
  customerName    String
  phone           String
  address         String
  city            String
  note            String?
  shippingCarrier String?
  trackingCode    String?
  paidAt          DateTime?
  paymentProvider String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon          Coupon?       @relation(fields: [couponCode], references: [code], onDelete: SetNull)
  items           OrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
}

model PaymentTransaction {
  id                    String   @id @default(uuid())
  provider              String
  providerTransactionId String
  orderId               String?
  referenceCode         String?
  amount                Int
  transferType          String
  content               String
  gateway               String?
  accountNumber         String?
  matched               Boolean  @default(false)
  failureReason         String?
  rawPayload            Json
  receivedAt            DateTime @default(now())
  order                 Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  @@index([orderId])
  @@index([matched, receivedAt])
}

model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      String
  productId    String
  variantId    String?
  productName  String
  productImage String
  productColor String
  productPrice Int
  size         String?
  quantity     Int
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model SocialPost {
  id          String            @id @default(uuid())
  slug        String            @unique
  userId      String?
  platform    String
  authorName  String
  authorHandle String
  caption     String
  image       String
  videoUrl    String?
  status      SocialPostStatus  @default(pending)
  likes       Int               @default(0)
  comments    Int               @default(0)
  saves       Int               @default(0)
  publishedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  products    SocialPostProduct[]
  events      SocialEvent[]

  @@index([status, publishedAt])
}

model SocialPostProduct {
  postId    String
  productId String
  sortOrder Int        @default(0)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

model SocialEvent {
  id        String      @id @default(uuid())
  userId    String?
  productId String?
  postId    String?
  type      String
  channel   String
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  post      SocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([type, channel, createdAt])
}

model UserStyleProfile {
  userId               String   @id
  preferredCategories  Json     @default("{}")
  preferredTypes       Json     @default("{}")
  preferredColors      Json     @default("{}")
  preferredStyles      Json     @default("{}")
  preferredOccasions   Json     @default("{}")
  preferredFits        Json     @default("{}")
  priceMin             Int      @default(0)
  priceMax             Int      @default(5000000)
  sizeProfile          Json     @default("{}")
  avoidAttributes      Json     @default("[]")
  confidence           Float    @default(0)
  eventCount           Int      @default(0)
  lastLearnedAt        DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBehaviorEvent {
  id        String            @id @default(uuid())
  userId    String?
  guestKey  String?
  productId String?
  type      BehaviorEventType
  source    String            @default("storefront")
  query     String?
  metadata  Json              @default("{}")
  weight    Float             @default(1)
  createdAt DateTime          @default(now())
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId, type, createdAt])
  @@index([guestKey, createdAt])
}

model ProductAffinity {
  id        String   @id @default(uuid())
  userId    String
  productId String
  score     Float    @default(0)
  signals   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, score])
}

model AIRecommendation {
  id                 String                 @id @default(uuid())
  userId             String?
  conversationId     String?
  requestText        String
  context            Json                   @default("{}")
  productIds         Json                   @default("[]")
  scores             Json                   @default("{}")
  reason             String?
  model              String                 @default("rules+llm")
  feedback           RecommendationFeedback @default(unknown)
  acceptedProductIds Json                   @default("[]")
  createdAt          DateTime               @default(now())
  feedbackAt         DateTime?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       ChatConversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
}

model TryOnSession {
  id               String      @id @default(uuid())
  userId           String?
  personImageHash  String?
  productIds       Json        @default("[]")
  categorySequence Json        @default("[]")
  status           TryOnStatus @default(created)
  resultUrl        String?
  rating           Int?
  accepted         Boolean?
  errorMessage     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment       OutfitAssessment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OutfitAssessment {
  id                String   @id @default(uuid())
  tryOnSessionId    String   @unique
  userId            String?
  productIds        Json     @default("[]")
  overallScore      Int
  colorScore        Int
  proportionScore   Int
  styleScore        Int
  preferenceScore  Int
  renderScore       Int
  verdict           String
  summary           String
  positives         Json     @default("[]")
  cautions          Json     @default("[]")
  suggestions       Json     @default("[]")
  mode              String
  profileConfidence Int      @default(0)
  feedback          String?
  feedbackAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tryOnSession      TryOnSession @relation(fields: [tryOnSessionId], references: [id], onDelete: Cascade)
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([overallScore, createdAt])
}

model StoreSetting {
  key   String @id
  value String
}
