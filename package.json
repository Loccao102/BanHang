{
  "name": "lsoul-fashion-commerce",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:store": "next dev -p 3000",
    "dev:admin": "next dev -p 3001",
    "dev:all": "node scripts/run-services.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "start:admin": "next start -H 0.0.0.0 -p 3001",
    "lint": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:chat": "tsx src/lib/server/chat-regression.ts",
    "test:quality": "tsx src/lib/server/quality-regression.ts",
    "test:webhook": "node scripts/test-sepay-webhook.mjs",
    "images:audit": "node scripts/audit-product-images.mjs",
    "images:plan": "tsx scripts/generate-missing-images.ts --list",
    "images:generate": "tsx scripts/generate-missing-images.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:docker:init": "node scripts/docker-db-init.mjs",
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f web postgres",
    "ai:rebuild": "tsx scripts/rebuild-ai-profiles.ts",
    "ai:eval": "tsx scripts/chat-eval-report.ts",
    "db:catalog": "node scripts/db-catalog-sync.mjs",
    "run:first": "docker compose up -d --build",
    "start:app": "docker compose up -d",
    "stop:app": "docker compose stop"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@gradio/client": "2.7.0",
    "@prisma/client": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
